{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wayland Protocol Specification Schema",
  "description": "JSON representation of Wayland XML interfaces, requests, and events",
  "type": "object",
  "properties": {
    "protocol": { "type": "string" },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "integer" },
          "description": { "type": "string" },
          "requests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "type"],
                    "properties": {
                      "name": { "type": "string" },
                      "type": { "type": "string" },
                      "interface": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "type"],
                    "properties": {
                      "name": { "type": "string" },
                      "type": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": ["protocol", "interfaces"]
}
